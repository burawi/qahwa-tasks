{
  "name": "qahwa-tasks",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:web && npm run build:server",
    "build:server": "tsc -p tsconfig.server.json",
    "build:web": "vite build",
    "dev": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "start": "node dist/server/server/index.js",
    "mcp": "node dist/server/mcp/index.js",
    "pair": "tsx src/scripts/create-pairing-link.ts",
    "pair:production": "DATA_DIR=/home/burawi/.local/share/qahwa-tasks BACKUP_DIR=/home/burawi/.local/share/qahwa-tasks/backups PUBLIC_BASE_URL=https://tasks.qahwa.pro tsx src/scripts/create-pairing-link.ts",
    "orchestrator:directive": "tsx src/scripts/set-orchestrator-directive.ts",
    "import:qahwa-design": "tsx src/scripts/import-qahwa-design.ts",
    "backup": "tsx src/scripts/backup.ts",
    "deploy:self": "tsx src/scripts/deploy-self.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fastify/static": "^10.1.6",
    "@fastify/websocket": "^11.3.4",
    "@modelcontextprotocol/sdk": "^1.24.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^11.10.0",
    "fastify": "^5.6.2",
    "lucide-react": "^0.468.0",
    "mdast-util-from-markdown": "^2.1.0",
    "node-pty": "^1.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tweetnacl": "^1.0.3",
    "web-push": "^3.6.7",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.1.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.7"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
